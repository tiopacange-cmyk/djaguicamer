import { supabase } from "./supabaseClient";

export async function fetchThemeActuel() {
  const { data, error } = await supabase
    .from("platform_settings")
    .select("theme")
    .eq("id", 1)
    .maybeSingle();
  if (error) throw error;
  return data?.theme || "vert";
}

// Réservé au Super Admin — s'applique à toute l'application, pour
// tous les groupes, au prochain chargement de la page.
export async function definirTheme(theme) {
  const { error } = await supabase.from("platform_settings").update({ theme }).eq("id", 1);
  if (error) throw error;
}
